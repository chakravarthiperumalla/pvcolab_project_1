DATABASE_URL=sqlite:///./roadmaps.db
SECRET_KEY=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...

# Models (override if you like)
PLANNER_MODEL=claude-sonnet-4-6
DAY_MODEL=claude-sonnet-4-6
QUIZ_MODEL=claude-haiku-4-5

# Generation limits
MAX_DAYS=180
DAYS_PER_MODULE=6
LLM_WORKERS=4
MAX_ACTIVE_ROADMAPS_PER_USER=2

# Frontend origin (used for CORS and links in emails)
FRONTEND_URL=http://localhost:5173

# Optional SMTP for "email me my handbook" (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
